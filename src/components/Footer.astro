---
import Logo from './Logo.astro';

const año = new Date().getFullYear();
---

<footer class="bg-bosque text-blanco">
	<div
		class="mx-auto flex justify-between max-w-6xl gap-y-14 px-6 pt-24 pb-20 sm:px-10 sm:pt-32 sm:pb-24 lg:grid-cols-12 lg:gap-x-10 lg:px-16 lg:pt-40 lg:pb-28"
	>
		<div class="flex items-center pt-12 gap-5 lg:col-span-3 lg:self-start">
			<Logo class="h-14 w-auto text-blanco" />
			<div>
				<p class="text-[1.375rem] leading-tight font-medium">Digital</p>
				<p class="mt-1 text-[1.0625rem] text-blanco/75">Tu web a medida.</p>
			</div>
		</div>
		<div class="lg:col-span-9">
			<p class="text-[clamp(2.75rem,7vw,4rem)] leading-none font-light tracking-[-0.04em] tabular-nums">
				625 390 963
			</p>
			<p class="mt-5 text-[clamp(1.375rem,2.6vw,2.25rem)] font-light break-all text-blanco/80 sm:break-normal">
				info@diegodesalas.com
			</p>
		</div>
	</div>

	<div class="mx-auto max-w-352 px-6 sm:px-10 lg:px-16">
		<div
			class="flex flex-col gap-3 border-t border-blanco/20 py-6 text-[0.8125rem] text-blanco/70 sm:flex-row sm:items-center sm:justify-between"
		>
			<p>© {año} SG Digital. Todos los derechos reservados.</p>
			<ul class="flex flex-wrap gap-x-3 gap-y-2">
				<li><a href="/aviso-legal" class="underline-offset-4 hover:underline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-blanco">Aviso legal</a></li>
				<li aria-hidden="true">·</li>
				<li><a href="/politica-de-privacidad" class="underline-offset-4 hover:underline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-blanco">Política de privacidad</a></li>
				<li aria-hidden="true">·</li>
				<li><a href="/politica-de-cookies" class="underline-offset-4 hover:underline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-blanco">Política de cookies</a></li>
			</ul>
		</div>
	</div>
</footer>
