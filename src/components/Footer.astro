---
import Logo from './Logo.astro';

const año = new Date().getFullYear();
---

<footer class="bg-bosque text-blanco">
	<div
		class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-x-10 gap-y-14 px-6 pt-24 pb-20 text-center sm:flex-row sm:px-10 sm:pt-32 sm:pb-24 sm:text-left lg:px-16 lg:pt-40 lg:pb-28"
	>
		<div class="flex items-center gap-5">
			<Logo class="h-14 w-auto text-blanco" />
			<div class="text-left">
				<p class="text-[1.375rem] leading-tight font-medium">Digital</p>
				<p class="mt-1 text-[1.0625rem] text-blanco/75">Tu web a medida.</p>
			</div>
		</div>
		<div>
			<p class="text-[clamp(2.75rem,7vw,4rem)] leading-none font-light tracking-[-0.04em] tabular-nums">
				625 390 963
			</p>
			<p class="mt-5 text-[clamp(1.375rem,2.6vw,2.25rem)] font-light break-all text-blanco/80 sm:break-normal">
				info@diegodesalas.com
			</p>
		</div>
	</div>

	<div class="mx-auto max-w-352 px-6 sm:px-10 lg:px-16">
		<div
			class="flex flex-col items-center gap-3 border-t border-blanco/20 py-6 text-center text-[0.8125rem] text-blanco/70 sm:flex-row sm:justify-between sm:text-left"
		>
			<p>© {año} SG Digital. Todos los derechos reservados.</p>
			<ul class="flex gap-x-2 text-[0.75rem] whitespace-nowrap max-[359px]:flex-wrap max-[359px]:justify-center sm:flex-wrap sm:gap-x-3 sm:gap-y-2 sm:text-[0.8125rem]">
				<li><a href="/aviso-legal" class="underline-offset-4 sm:text-sm hover:underline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-blanco">Aviso legal</a></li>
				<li aria-hidden="true">·</li>
				<li><a href="/politica-de-privacidad" class="underline-offset-4 sm:text-sm hover:underline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-blanco">Política de privacidad</a></li>
				<li aria-hidden="true">·</li>
				<li><a href="/politica-de-cookies" class="underline-offset-4 sm:text-sm hover:underline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-blanco">Política de cookies</a></li>
			</ul>
		</div>
	</div>
</footer>
