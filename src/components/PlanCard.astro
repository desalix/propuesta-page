---
interface Props {
	nombre: string;
	precio: string;
	sufijo?: string;
	subtitulo?: string;
	nota?: string;
	caracteristicas: string[];
	destacado?: boolean;
	listaDoble?: boolean;
}

const {
	nombre,
	precio,
	sufijo,
	subtitulo,
	nota,
	caracteristicas,
	destacado = false,
	listaDoble = false,
} = Astro.props;

// Sin hover ni transiciones: la tarjeta es informativa, no se puede pulsar.
const borde = destacado ? 'border-2 border-azul' : 'border border-linea';
---

<article class={`flex flex-col gap-5 rounded-[20px] bg-white p-7 sm:p-9 ${borde}`}>
	<h3 class="font-display text-xl font-bold sm:text-2xl">{nombre}</h3>

	<div>
		<p class="font-display text-[clamp(2rem,4.5vw,2.5rem)] font-extrabold text-azul">
			{precio}{sufijo && <span class="font-bold text-humo">&nbsp;{sufijo}</span>}
		</p>
		{subtitulo && <p class="mt-1 text-[15px] text-humo">{subtitulo}</p>}
	</div>

	{nota && <p class="text-[16px] font-bold">{nota}</p>}

	<ul
		class={`list-disc space-y-2 ps-[1.2em] text-[15px] leading-7 ${listaDoble ? 'sm:columns-2 sm:gap-x-10 sm:space-y-0' : ''}`}
	>
		{caracteristicas.map((c) => <li class={listaDoble ? 'mb-2 break-inside-avoid' : ''}>{c}</li>)}
	</ul>
</article>
