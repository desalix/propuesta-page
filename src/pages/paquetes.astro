---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Plan from '../components/Plan.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Planes y precios | SG Digital"
	description="Webs a medida para empresas y eventos en Madrid. Esencial 399 €, Estándar 699 €, Premium 999 €, mantenimiento desde 29 € al mes."
>
	<Header enPaquetes />

	<main>
		<!-- Paquetes -->
		<section id="paquetes" class="bg-blanco" aria-labelledby="titulo-paquetes">
			<div class="mx-auto max-w-352 px-6 sm:px-10 lg:px-16">
				<div class="py-24 sm:py-32 lg:py-40">
					<h2
						id="titulo-paquetes"
						class="max-w-[24ch] font-serif text-[clamp(2.75rem,5.5vw,4.5rem)] leading-[1.02] tracking-[-0.01em]"
					>
						Nuestros paquetes
					</h2>
					<div class="mt-16 flex flex-col gap-16 sm:mt-20 md:flex-row md:justify-between md:gap-10">
						<Plan
							columna
							class="w-full md:max-w-88"
							nombre="Esencial"
							precio="399 €"
							caracteristicas={[
								'Landing page',
								'Diseño responsive con tus colores y tu logo.',
								'Implementación de SEO básica.',
							]}
						/>
						<Plan
							columna
							class="w-full md:max-w-88"
							nombre="Estándar"
							precio="699 €"
							caracteristicas={[
								'Páginas: inicio, personalizada y quiénes somos.',
								'Implementación de Base de Datos.',
								'Panel de administrador para modificaciones.',
								'Páginas legales: aviso legal, política de privacidad y política de cookies.',
							]}
						/>
						<Plan
							columna
							class="w-full md:max-w-88"
							nombre="Premium"
							precio="999 €"
							nota="Todo lo del paquete Estándar, más:"
							caracteristicas={[
								'Funcionalidades especiales a medida: cuéntanos qué quieres y lo estudiamos.',
								'Servicio de email corporativo.',
								'Seo profesional.',
								'Google Review NFC incluido.',
							]}
						/>
					</div>
				</div>
			</div>
		</section>

		<!-- Mensualidad -->
		<section id="mensualidad" class="bg-salvia" aria-labelledby="titulo-mensualidad">
			<div class="mx-auto max-w-352 px-6 sm:px-10 lg:px-16">
				<div class="filete" aria-hidden="true"></div>
				<div class="grid gap-y-10 py-24 sm:py-32 lg:grid-cols-12 lg:gap-x-10 lg:py-40">
					<p class="flex items-center gap-3 text-[1.1875rem] font-medium text-verde lg:sticky lg:top-40 lg:col-span-3 lg:self-start">
						<span class="size-2 rounded-full bg-verde" aria-hidden="true"></span>
						Mensualidad
					</p>
					<div class="lg:col-span-9">
						<h2
							id="titulo-mensualidad"
							class="max-w-[24ch] font-serif text-[clamp(2.75rem,5.5vw,4.5rem)] leading-[1.02] tracking-[-0.01em]"
						>
							Mantenimiento mensual
						</h2>
						<div class="mt-16 sm:mt-20">
							<Plan
								nombre="Básico"
								precio="29 €"
								sufijo="/ mes"
								caracteristicas={[
									'Soporte a través de email.',
									'Mantenimiento de errores funcionales.',
									'Actualizaciones de seguridad.',
								]}
							/>
							<Plan
								nombre="Plus"
								precio="49 €"
								sufijo="/ mes"
								nota="Todo lo del paquete Básico, más:"
								caracteristicas={[
									'Soporte a través de WhatsApp.',
									'Copias de seguridad mensuales.',
									'Cambios en el diseño (4 horas).',
									'Mantenimiento de SEO.',
								]}
							/>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Hosting -->
		<section id="hosting" class="bg-blanco" aria-labelledby="titulo-hosting">
			<div class="mx-auto max-w-352 px-6 sm:px-10 lg:px-16">
				<div class="filete" aria-hidden="true"></div>
				<div class="py-24 sm:py-32 lg:py-40">
					<h2
						id="titulo-hosting"
						class="max-w-[24ch] font-serif text-[clamp(2.75rem,5.5vw,4.5rem)] leading-[1.02] tracking-[-0.01em]"
					>
						Otros
					</h2>
					<div class="mt-16 flex flex-col gap-16 sm:mt-20 md:flex-row md:justify-around md:gap-10">
						<Plan
							columna
							class="w-full md:max-w-104"
							nombre="Hosting"
							precio="Incluido"
							subtitulo="dentro de la cuota de mantenimiento"
						/>
						<Plan
							columna
							class="w-full md:max-w-104"
							nombre="Dominio"
							precio="Aparte"
							subtitulo="a cargo del cliente"
						/>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
