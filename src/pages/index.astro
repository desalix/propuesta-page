---
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import Logo from '../components/Logo.astro';
import hero from '../assets/hero.jpeg';
import smithers from '../assets/projects/smithers.png';
import carmovil from '../assets/projects/carmovil.png';
import autoclub from '../assets/projects/autoclubtrackdays.png';
import iphone from '../assets/iphone-diseno.png';
import Footer from '../components/Footer.astro';
---

<Layout
	title="SG Digital | Webs a medida en Madrid"
	description="SG Digital diseña webs a medida para todo tipo de empresas y eventos en Madrid."
>
	<div id="pista-portada" class="pista-portada">
		<section class="portada" aria-labelledby="titulo-portada">
			<div class="lienzo">
				<Picture
					src={hero}
					formats={['avif', 'webp']}
					widths={[960, 1440, 1920, 2752]}
					sizes="(min-aspect-ratio: 2752/1536) 100vw, 179vh"
					alt=""
					loading="eager"
					fetchpriority="high"
					class="absolute inset-0 size-full"
				/>
				<div class="pantalla flex items-center justify-center">
					<Logo class="logo-trazo h-[5.5cqw] w-auto text-tinta" />
				</div>
			</div>
		</section>
	</div>

	<main>
		<header class="sticky top-0 z-20">
			<!-- Barra blanca con la línea como borde inferior -->
			<div class="bg-blanco">
				<div class="mx-auto max-w-352 px-6 sm:px-10 lg:px-16">
					<div class="flex items-center justify-between gap-6 border-b border-hilo py-6 sm:py-8">
						<Logo class="h-11 w-auto text-tinta sm:h-12" />
						<a
							href="/paquetes"
							class="font-serif text-[1.375rem] text-tinta decoration-1 underline-offset-4 focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-tinta sm:text-2xl hover:underline"
						>
							Paquetes
						</a>
					</div>
				</div>
			</div>
		</header>

		<!-- SG Digital -->
		<section class="overflow-x-clip bg-blanco" aria-labelledby="titulo-sg">
			<div class="mx-auto max-w-352 px-6 sm:px-10 lg:px-16">
				<div class="relative py-24 sm:py-32 lg:py-40">
					<!-- Bloque de texto: por encima del iPhone cuando este entra desde la izquierda -->
					<div class="relative z-10">
						<h2 id="titulo-sg" class="font-serif text-[clamp(4.5rem,15vw,13rem)] leading-[0.9] tracking-[-0.02em]">
							SG Digital
						</h2>
						<p class="mt-10 max-w-[42ch] text-[clamp(1.25rem,2vw,1.5rem)] leading-[1.45]">
							Diseñamos y desarrollamos webs a medida y las herramientas que hay detrás: paneles para
							gestionar tu contenido, catálogos, reservas y lo que tu negocio necesite.
						</p>
						<ul class="lista mt-14 flex flex-wrap gap-x-12 text-[1.1875rem] text-grafito">
							<li>Desarrollo web</li>
							<li>Herramientas a medida</li>
							<li>Imagen y marca</li>
						</ul>
					</div>

					<Picture
						src={iphone}
						alt=""
						formats={['avif', 'webp']}
						widths={[400, 664]}
						sizes="(min-width: 80rem) 25vw, 22rem"
						class="telefono mx-auto mt-16 w-[min(78%,22rem)] xl:absolute xl:top-1/2 xl:right-0 xl:mt-0 xl:w-[clamp(20rem,25vw,24rem)] xl:-translate-y-1/2"
					/>
				</div>
			</div>
		</section>

		<!-- Proyectos -->
		<section id="proyectos" class="overflow-x-clip bg-blanco" aria-labelledby="titulo-proyectos">
			<div class="mx-auto max-w-352 px-6 sm:px-10 lg:px-16">
				<div class="h-px bg-hilo" aria-hidden="true"></div>
				<div class="py-24 sm:py-32 lg:py-40">
					<h2
						id="titulo-proyectos"
						class="max-w-[24ch] font-serif text-[clamp(2.75rem,5.5vw,4.5rem)] leading-[1.02] tracking-[-0.01em]"
					>
						Proyectos
					</h2>
					<p class="mt-8 max-w-[34ch] text-[clamp(1.25rem,2vw,1.5rem)] leading-[1.4] text-grafito">
						Hacemos webs para todo tipo de empresas y eventos. Estas son algunas.
					</p>

					<div class="mt-24 grid gap-x-16 gap-y-24 sm:mt-32 md:grid-cols-[repeat(2,minmax(0,29rem))] md:justify-around lg:gap-y-32">
						<!-- Autoclub Trackdays -->
						<article class="proyecto flex flex-col border-t border-hilo pt-10">
							<Picture
								src={autoclub}
								alt="Página de inicio de la web de Autoclub Trackdays"
								formats={['avif', 'webp']}
								fallbackFormat="jpg"
								width={1280}
								height={800}
								widths={[640, 960, 1280]}
								sizes="(min-width: 64rem) 29rem, (min-width: 48rem) 45vw, 100vw"
								fit="cover"
								position="top"
								class="aspect-16/10 w-full bg-salvia object-cover object-top"
							/>
							<h3 class="mt-10 font-serif text-[clamp(2.25rem,3.4vw,3rem)] leading-[1.05]">
								Autoclub Trackdays
							</h3>
							<p class="mt-2 text-[1.0625rem] text-grafito">Compraventa de coches, Madrid</p>
							<p class="mt-6 max-w-[48ch] text-[1.1875rem] leading-[1.6]">
								Más de 25 años comprando y vendiendo coches de ocasión. Diseñamos su catálogo, con los coches destacados en portada y contacto directo por WhatsApp, y un panel a medida para que gestionen ellos mismos el inventario.
							</p>
						</article>

						<!-- Carmovil -->
						<article class="proyecto flex flex-col border-t border-hilo pt-10">
							<Picture
								src={carmovil}
								alt="Página de inicio de la web de Autotalleres Carmovil"
								formats={['avif', 'webp']}
								fallbackFormat="jpg"
								width={1280}
								height={800}
								widths={[640, 960, 1280]}
								sizes="(min-width: 64rem) 29rem, (min-width: 48rem) 45vw, 100vw"
								fit="cover"
								position="top"
								class="aspect-16/10 w-full bg-salvia object-cover object-top"
							/>
							<h3 class="mt-10 font-serif text-[clamp(2.25rem,3.4vw,3rem)] leading-[1.05]">
								Autotalleres Carmovil
							</h3>
							<p class="mt-2 text-[1.0625rem] text-grafito">Taller mecánico, Tres Cantos</p>
							<p class="mt-6 max-w-[48ch] text-[1.1875rem] leading-[1.6]">
								Un taller familiar desde 1991 con una web de hace años que pedía un lavado de cara. Renovamos su imagen y su marca: ahora su web explica cómo trabajan, qué servicios ofrecen y qué dicen sus clientes, y deja pedir cita con un toque.
							</p>
						</article>

						<!-- Smithers -->
						<article class="proyecto flex flex-col border-t border-hilo pt-10">
							<Picture
								src={smithers}
								alt="Página de inicio de la web de Smithers Restaurant"
								formats={['avif', 'webp']}
								fallbackFormat="jpg"
								width={1280}
								height={800}
								widths={[640, 960, 1280]}
								sizes="(min-width: 64rem) 29rem, (min-width: 48rem) 45vw, 100vw"
								fit="cover"
								position="top"
								class="aspect-16/10 w-full bg-salvia object-cover object-top"
							/>
							<h3 class="mt-10 font-serif text-[clamp(2.25rem,3.4vw,3rem)] leading-[1.05]">
								Smithers Restaurant
							</h3>
							<p class="mt-2 text-[1.0625rem] text-grafito">Restaurante, Madrid</p>
							<p class="mt-6 max-w-[48ch] text-[1.1875rem] leading-[1.6]">
								Desayunos y menú del día en Madrid. Querían una imagen profesional para su nueva apertura: les hicimos una web con carta, menú, galería y eventos, con las reservas de esos eventos gestionadas desde la propia web.
							</p>
						</article>
					</div>
				</div>
			</div>
		</section>

		<!-- Interesado -->
		<section class="bg-salvia" aria-labelledby="titulo-interesado">
			<div
				class="mx-auto flex max-w-352 flex-col gap-8 px-6 py-24 sm:flex-row sm:items-baseline sm:justify-around sm:px-10 sm:py-48 lg:px-16"
			>
				<h2
					id="titulo-interesado"
					class="font-serif text-[clamp(2.75rem,5.5vw,4.5rem)] leading-[1.02] tracking-[-0.01em]"
				>
					¿Interesado?
				</h2>
				<a
					href="/paquetes"
					class="font-serif text-[clamp(1.75rem,3vw,3.5rem)] text-verde underline decoration-1 underline-offset-8 hover:text-black transition-colors focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-verde"
				>
					Descúbrenos <span aria-hidden="true">→</span>
				</a>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	// Al hacer scroll la cámara entra en la pantalla del portátil. Primero el logo
	// de la pantalla se funde a blanco y desde ese blanco aparece una copia del principio
	// de <main> (barra + SG Digital); cuando el zoom termina, la copia está a tamaño real
	// justo donde va el contenido de verdad, se cambia una por otra y el scroll sigue normal.
	// Al llegar, el iPhone de SG Digital entra solo desde la izquierda; si se vuelve a subir
	// a la escena, se recoge y la próxima vez vuelve a entrar.
	const pista = document.getElementById('pista-portada')!;
	const portada = pista.querySelector<HTMLElement>('.portada')!;
	const lienzo = pista.querySelector<HTMLElement>('.lienzo')!;
	const logoPantalla = lienzo.querySelector<HTMLElement>('.pantalla')!;
	const principal = pista.nextElementSibling as HTMLElement; // <main>
	const telefono = principal.querySelector<HTMLElement>('.telefono')!;
	const reducir = matchMedia('(prefers-reduced-motion: reduce)');

	// Pantalla del portátil dentro de hero.jpeg, en fracciones del lienzo.
	const PANTALLA = { x: 0.3579, y: 0.388, ancho: 0.2878, alto: 0.334 };
	const RECORRIDO = 1.2; // alturas de pantalla que dura la escena
	const DESVANECIDO = 0.15; // el logo de la pantalla se funde a blanco en este primer tramo
	const APARICION = 0.4; // después, la copia del contenido aparece desde el blanco en este tramo

	let copia: HTMLElement | null = null;
	let recorrido = 0;
	let escalaFinal = 1;
	let dx = 0;
	let dy = 0;
	let ancho = 0;
	let alto = 0;
	let pendiente = false;
	let soltada = false;

	function crearCopia() {
		// Un <div> con copias del contenido de <main> (no otro <main>: solo puede haber uno).
		const c = document.createElement('div');
		for (const hijo of principal.children) c.append(hijo.cloneNode(true));
		c.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
		c.querySelectorAll('[aria-labelledby]').forEach((el) => el.removeAttribute('aria-labelledby'));
		c.classList.add('copia-principal');
		c.inert = true;
		// Justo encima de la foto.
		lienzo.after(c);
		return c;
	}

	function medir() {
		ancho = portada.clientWidth;
		alto = portada.offsetHeight;
		recorrido = alto * RECORRIDO;
		pista.style.height = `${alto + recorrido}px`;
		// El contenido real sube una pantalla: al soltarse la portada queda justo encima de su último fotograma.
		principal.style.marginTop = `${-alto}px`;

		const W = lienzo.offsetWidth;
		const H = lienzo.offsetHeight;
		// Escala a la que la pantalla blanca cubre toda la ventana (con un pequeño margen).
		escalaFinal = Math.max(ancho / (PANTALLA.ancho * W), alto / (PANTALLA.alto * H)) * 1.06;
		// Distancia del centro de la pantalla al centro del lienzo, para llevarla al centro de la ventana.
		dx = (PANTALLA.x + PANTALLA.ancho / 2 - 0.5) * W;
		dy = (PANTALLA.y + PANTALLA.alto / 2 - 0.5) * H;

		copia!.style.width = `${ancho}px`;
		copia!.style.height = `${alto}px`;
	}

	function pintar() {
		pendiente = false;
		const avance = Math.min(Math.max((scrollY - pista.offsetTop) / recorrido, 0), 1);
		const e = avance * avance * (3 - 2 * avance);

		// Escala exponencial: el acercamiento se percibe a velocidad constante.
		const escala = Math.pow(escalaFinal, e);
		lienzo.style.transform = `translate(${-dx * e}px, ${-dy * e}px) scale(${escala})`;

		// La copia sigue a la pantalla: mismo centro y la misma escala relativa. Al final
		// escala / escalaFinal = 1 y el centro coincide con el de la ventana: transform none.
		// (Se fija un poco antes: con una escala casi-1 el navegador coloca el texto un par de
		// píxeles distinto que sin transform y se notaría el relevo.)
		copia!.style.transform =
			e >= 0.999 ? 'none' : `translate(${dx * (1 - e)}px, ${dy * (1 - e)}px) scale(${escala / escalaFinal})`;
		logoPantalla.style.opacity = String(1 - Math.min(avance / DESVANECIDO, 1));
		copia!.style.opacity = String(Math.min(Math.max((avance - DESVANECIDO) / APARICION, 0), 1));
		// El contenido real solo se ve cuando la portada se suelta; hasta entonces la tapa la copia.
		const suelta = avance >= 1;
		principal.style.visibility = suelta ? '' : 'hidden';
		if (suelta !== soltada) {
			soltada = suelta;
			// De vuelta en la escena: el iPhone se recoge para volver a entrar la próxima vez.
			if (!suelta) telefono.classList.remove('dentro');
		}
		// Ya en la página: el iPhone entra cuando al menos la mitad está a la vista
		// (en escritorio, nada más llegar; en móvil, donde va debajo del texto, al bajar hasta él).
		if (soltada && !telefono.classList.contains('dentro')) {
			const r = telefono.getBoundingClientRect();
			if (r.top + r.height / 2 < innerHeight && r.bottom - r.height / 2 > 0) telefono.classList.add('dentro');
		}
	}

	function alDesplazar() {
		if (!pendiente) {
			pendiente = true;
			requestAnimationFrame(pintar);
		}
	}

	function alRedimensionar() {
		medir();
		pintar();
	}

	function activar() {
		copia ??= crearCopia();
		pista.classList.add('zoom');
		medir();
		pintar();
		addEventListener('scroll', alDesplazar, { passive: true });
		addEventListener('resize', alRedimensionar);
	}

	function desactivar() {
		pista.classList.remove('zoom');
		removeEventListener('scroll', alDesplazar);
		removeEventListener('resize', alRedimensionar);
		copia?.remove();
		copia = null;
		pista.style.height = '';
		lienzo.style.transform = '';
		logoPantalla.style.opacity = '';
		principal.style.marginTop = '';
		principal.style.visibility = '';
		telefono.classList.remove('dentro');
		soltada = false;
	}

	if (!reducir.matches) activar();
	reducir.addEventListener('change', () => (reducir.matches ? desactivar() : activar()));
</script>
