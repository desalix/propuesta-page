---
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import Logo from '../components/Logo.astro';
import hero from '../assets/hero.jpeg';
import Plan from '../components/Plan.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Planes y precios | SG Digital"
	description="Webs para concesionarios de coches y talleres en Madrid. Estándar 549 €, Premium 799 €, mantenimiento desde 29 € al mes."
>
	<section class="portada" aria-labelledby="titulo-portada">
		<div class="lienzo">
			<Picture
				src={hero}
				formats={['avif', 'webp']}
				widths={[960, 1440, 1920, 2752]}
				sizes="(min-aspect-ratio: 2752/1536) 100vw, 179vh"
				alt=""
				loading="eager"
				fetchpriority="high"
				class="absolute inset-0 size-full"
			/>
		</div>

		<header class="absolute inset-x-0 top-0 z-10 bg-linear-to-b from-blanco to-transparent pb-18">
			<div class="mx-auto flex max-w-352 items-center justify-center gap-8 px-6 pt-6 sm:px-10 sm:pt-8 lg:px-16">
				<Logo class="logo h-11 w-auto text-tinta sm:h-12" />
				<div class="aparece">
					<p class="text-[0.9375rem] text-grafito">Tu web a medida.</p>
				</div>
			</div>
		</header>
	</section>

	<main>
		<!-- Paquetes -->
		<section id="paquetes" class="bg-blanco" aria-labelledby="titulo-paquetes">
			<div class="mx-auto max-w-352 px-6 sm:px-10 lg:px-16">
				<div class="filete" aria-hidden="true"></div>
				<div class="grid gap-y-10 py-24 sm:py-32 lg:grid-cols-12 lg:gap-x-10 lg:py-40">
					<div class="lg:col-span-12">
						<h2
							id="titulo-paquetes"
							class="max-w-[24ch] text-[clamp(2.25rem,4.5vw,3.75rem)] leading-[1.05] tracking-[-0.03em]"
						>
							Nuestros paquetes
						</h2>
						<div class="mt-16 flex flex-col gap-16 sm:mt-20 md:flex-row md:justify-between md:gap-10">
							<Plan
								columna
								class="w-full md:max-w-88"
								nombre="Esencial"
								precio="399 €"
								caracteristicas={[
									'[Característica 1]',
									'[Característica 2]',
									'[Característica 3]',
									'[Característica 4]',
								]}
							/>
							<Plan
								columna
								class="w-full md:max-w-88"
								nombre="Estándar"
								precio="699 €"
								caracteristicas={[
									'Páginas: inicio, catálogo, ficha de vehículo y quiénes somos.',
									'Diseño responsive con tus colores y tu logo.',
									'Listado de catálogo con búsqueda y orden.',
									'Panel de administrador.',
									'Mapa y datos del concesionario.',
									'Páginas legales: aviso legal, política de privacidad y política de cookies.',
								]}
							/>
							<Plan
								columna
								class="w-full md:max-w-88"
								nombre="Premium"
								precio="999 €"
								nota="Todo lo del paquete Estándar, más:"
								caracteristicas={[
									'Funcionalidades especiales a medida: cuéntanos qué quieres y lo estudiamos.',
									'Te añadimos todos los coches que tengas actualmente disponibles.',
									'Google Review NFC incluido.',
									'Servicio de email corporativo.',
								]}
							/>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Mensualidad -->
		<section id="mensualidad" class="bg-salvia" aria-labelledby="titulo-mensualidad">
			<div class="mx-auto max-w-352 px-6 sm:px-10 lg:px-16">
				<div class="filete" aria-hidden="true"></div>
				<div class="grid gap-y-10 py-24 sm:py-32 lg:grid-cols-12 lg:gap-x-10 lg:py-40">
					<p class="flex items-center gap-3 text-[1.1875rem] font-medium text-verde lg:sticky lg:top-12 lg:col-span-3 lg:self-start">
						<span class="size-2 rounded-full bg-verde" aria-hidden="true"></span>
						Mensualidad
					</p>
					<div class="lg:col-span-9">
						<h2
							id="titulo-mensualidad"
							class="max-w-[24ch] text-[clamp(2.25rem,4.5vw,3.75rem)] leading-[1.05] tracking-[-0.03em]"
						>
							Mantenimiento mensual
						</h2>
						<div class="mt-16 sm:mt-20">
							<Plan
								nombre="Básico"
								precio="29 €"
								sufijo="/ mes"
								subtitulo="cuota mensual, opcional"
								caracteristicas={[
									'Soporte a través de email.',
									'Mantenimiento de errores funcionales.',
									'Actualizaciones de seguridad.',
									'Hosting de la página.',
								]}
							/>
							<Plan
								nombre="Plus"
								precio="49 €"
								sufijo="/ mes"
								subtitulo="cuota mensual, opcional"
								nota="Todo lo del paquete Básico, más:"
								caracteristicas={[
									'Soporte a través de WhatsApp.',
									'Copias de seguridad mensuales.',
									'Cambios en el diseño.',
								]}
							/>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Hosting -->
		<section id="hosting" class="bg-blanco" aria-labelledby="titulo-hosting">
			<div class="mx-auto max-w-352 px-6 sm:px-10 lg:px-16">
				<div class="filete" aria-hidden="true"></div>
				<div class="grid gap-y-10 py-24 sm:py-32 lg:grid-cols-12 lg:gap-x-10 lg:py-40">
					<div class="lg:col-span-12">
						<h2
							id="titulo-hosting"
							class="max-w-[24ch] text-[clamp(2.25rem,4.5vw,3.75rem)] leading-[1.05] tracking-[-0.03em]"
						>
							Otros
						</h2>
						<div class="mt-16 flex flex-col gap-16 sm:mt-20 md:flex-row md:justify-around md:gap-10">
							<Plan
								columna
								class="w-full md:max-w-104"
								nombre="Hosting"
								precio="Incluido"
								subtitulo="dentro de la cuota de mantenimiento"
								caracteristicas={[
									'El hosting de la página va incluido en el mantenimiento.',
									'Sin coste aparte mientras el mantenimiento esté activo.',
								]}
							/>
							<Plan
								columna
								class="w-full md:max-w-104"
								nombre="Dominio"
								precio="Aparte"
								subtitulo="a cargo del cliente"
								caracteristicas={[
									'El gasto de titularidad del dominio corre a cargo del cliente.',
									'El dominio queda a nombre del concesionario.',
								]}
							/>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
